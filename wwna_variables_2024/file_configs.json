{
  "DMR": {
    "data_type": "DMR",
    "file_pattern": "CA_FY{year}_NPDES_DMRS.csv",
    "subdir_pattern": "CA_FY{year}_NPDES_DMRS_LIMITS",
    "download": {
      "url": "https://echo.epa.gov/files/echodownloads/NPDES_by_state_year",
      "size_threshold": 1000000
    },
    "dtype": {
      "EXTERNAL_PERMIT_NMBR": "str",
      "PARAMETER_CODE": "str",
      "PARAMETER_DESC": "str",
      "MONITORING_LOCATION_CODE": "str",
      "LIMIT_VALUE_TYPE_CODE": "str",
      "LIMIT_VALUE_STANDARD_UNITS": "float",
      "STANDARD_UNIT_CODE": "str",
      "STANDARD_UNIT_DESC": "str",
      "LIMIT_VALUE_QUALIFIER_CODE": "str",
      "LIMIT_SET_SCHEDULE_ID": "str",
      "DMR_VALUE_STANDARD_UNITS": "float",
      "NODI_CODE": "str"
    },
    "parse_dates": ["MONITORING_PERIOD_END_DATE"],
    "dropna": ["LIMIT_VALUE_STANDARD_UNITS"],
    "drop_notna": ["NODI_CODE"],
    "filters": {
      "MONITORING_LOCATION_CODE": ["1", "2", "EG", "Y", "K"]
    },
    "strip_leading_zeros": "PARAMETER_CODE",
    "mark_toxicity": {
      "column": "PARAMETER_CODE",
      "pattern": "startswith",
      "values": ["T", "W"],
      "set_value": "Toxicity"
    }
  },
  "LIMITS": {
    "data_type": "LIMITS",
    "base_dir_type": "DMR",
    "dtype": {
      "EXTERNAL_PERMIT_NMBR": "str",
      "PARAMETER_CODE": "str",
      "PARAMETER_DESC": "str",
      "LIMIT_VALUE_STANDARD_UNITS": "float"
    },
    "parse_dates": [],
    "dropna": [],
    "drop_notna": [],
    "filters": {},
    "file_pattern": "CA_FY{year}_NPDES_LIMITS.csv",
    "subdir_pattern": "CA_FY{year}_NPDES_DMRS_LIMITS"
  },
  "ESMR": {
    "data_type": "ESMR",
    "file_pattern": "esmr-analytical-export_year-{year}.csv",
    "dtype": {
      "parameter": "str",
      "sampling_date": "str"
    },
    "parse_dates": ["sampling_date"],
    "dropna": [],
    "drop_notna": [],
    "filters": {},
    "step1": {
      "column": "parameter",
      "desc_col": "ESMR_PARAMETER_DESC"
    },
    "download": {
      "url": "https://data.ca.gov/dataset/203e5d1f-ec9d-4d07-93aa-d8b74d3fe71f/resource",
      "size_threshold": 10000000
    },
    "year_config": {
      "2014": "c0f64b3f-d921-4eb9-aa95-af1827e5033e",
      "2015": "81c399d4-f661-4808-8e6b-8e543281f1c9",
      "2016": "aacfe728-f063-452c-9dca-63482cc994ad",
      "2017": "44d1f39c-f21b-4060-8225-c175eaea129d",
      "2018": "bb3b3d85-44eb-4813-bbf9-ea3a0e623bb7",
      "2019": "2eaa2d55-9024-431e-b902-9676db949174",
      "2020": "4fa56f3f-7dca-4dbd-bec4-fe53d5823905",
      "2021": "28d3a164-7cec-4baf-9b11-7a9322544cd6",
      "2022": "8c6296f7-e226-42b7-9605-235cd33cdee2",
      "2023": "65eb7023-86b6-4960-b714-5f6574d43556",
      "2024": "7adb8aea-62fb-412f-9e67-d13b0729222f",
      "2025": "176a58bf-6f5d-4e3f-9ed9-592a509870eb"
    }
  },
  "IR": {
    "data_type": "IR",
    "file_pattern": "{year}-303d.csv",
    "dtype": {
      "Water Body CALWNUMS": "str",
      "Pollutant": "str",
      "Pollutant Category": "str",
      "Decision Status": "str",
      "TMDL Requirement Status": "str",
      "Sources": "str",
      "Expected TMDL Completion Date": "str",
      "Expected Attainment Date": "str"
    },
    "parse_dates": [],
    "dropna": ["Water Body CALWNUMS"],
    "drop_notna": [],
    "filters": {},
    "skiprows": {
      "2018": 2,
      "2024": 1
    },
    "step1": {
      "column": "Pollutant",
      "desc_col": "IR_PARAMETER_DESC",
      "year": 2024,
      "skiprows": 1
    },
    "download": {
      "url": "https://www.waterboards.ca.gov/water_issues/programs/tmdl",
      "size_threshold": 1000000
    },
    "year_config": {
      "2018": "2018state_ir_reports_final/app_a_2018303d.xlsx",
      "2022": "2020_2022state_ir_reports_revised_final/apx-a-303d-list.xlsx",
      "2024": "2023_2024state_ir_reports/apx-a-2024-303d-list-final.xlsx"
    }
  },
  "TOXICS": {
    "file_pattern": "criteria_for_toxics.csv",
    "download": {
      "url": "https://data.ca.gov/dataset/7b2b5d26-9407-4368-8744-d5b659024dd7/resource/0d417a2b-6559-4725-820f-add7c57a8bc9/download/oehha-toxicity-criteria-database-20250408.csv",
      "size_threshold": 1000
    },
    "dtype": {
      "Number compound": "str",
      "CAS No.": "str"
    },
    "step1": {
      "column": "Number compound",
      "desc_col": "TOXICS_PARAMETER_DESC",
      "post_process": {
        "strip_prefix": {
          "pattern": "^\\d+\\.\\s*",
          "regex": true
        }
      }
    }
  },
  "CWNS": {
    "data_type": "CWNS",
    "file_pattern": "facilities_merged.csv",
    "download": {
      "url": "https://raw.githubusercontent.com/dalyw/us-sewersheds/refs/heads/main/processed_data/facilities_merged.csv",
      "size_threshold": 100000
    },
    "dtype": {
      "STATE_CODE": "str",
      "CWNS_ID": "str",
      "PERMIT_NUMBER": "str",
      "FACILITY_NAME": "str",
      "TOTAL_RES_POPULATION_2022": "float"
    },
    "parse_dates": [],
    "dropna": [],
    "drop_notna": [],
    "filters": {
      "STATE_CODE": ["CA"]
    },
    "rename": {
      "TOTAL_RES_POPULATION_2022": "population_cwns"
    },
    "drop_duplicates": ["CWNS_ID"]
  },
  "WW_SURVEILLANCE": {
    "data_type": "WW_SURVEILLANCE",
    "file_pattern": "wastewatersurveillancecalifornia.csv",
    "dtype": {
      "epaid": "str",
      "population_served": "float"
    },
    "explode": ["epaid"],
    "drop_duplicates": ["epaid"],
    "rename": {
      "population_served": "population_covid"
    }
  },
  "SSO": {
    "data_type": "SSO",
    "file_pattern": "Questionnaire.csv",
    "download": {
      "url": "https://www.waterboards.ca.gov/water_issues/programs/sso/docs/data_files/Questionnaire.txt",
      "size_threshold": 100000
    },
    "dtype": {
      "Wdid": "str",
      "SSOq Population Served": "float",
      "Status": "str"
    },
    "rename": {
      "SSOq Population Served": "population_sso",
      "Wdid": "permit_number"
    },
    "filters": {
      "Status": ["Active"]
    },
    "drop_duplicates": ["Wdid"]
  }
}

